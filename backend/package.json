{
  "name": "integrisea-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API IntegriSea",
  "main": "api.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --watch-path=api.js --watch-path=routes --watch-path=services --watch-path=middleware --watch-path=config --watch-path=utils --watch-path=../packages api.js",
    "start:prod": "node config/start-production.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js",
    "test:e2e": "node tests/e2e.smoke.js && node tests/security.smoke.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "docx": "^9.16.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.3",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.22.5",
    "pdfkit": "^0.21.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
