# Exemple : terminaison HTTPS (TLS) devant le conteneur « frontend » (qui écoute en HTTP sur FRONTEND_PORT).
# À placer sur le serveur d'entrée (nginx, ou équivalent : Caddy, Traefik, load balancer du cloud).
# Remplacer integrisea.example.com et les chemins des certificats (Let's Encrypt, PKI interne…).
# Dans .env.production : FRONTEND_URL=https://integrisea.example.com  et  TRUST_PROXY=1

server {
    listen 80;
    server_name integrisea.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name integrisea.example.com;

    ssl_certificate     /etc/letsencrypt/live/integrisea.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/integrisea.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 26m;

    location / {
        proxy_pass http://127.0.0.1:8080;   # FRONTEND_PORT
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
