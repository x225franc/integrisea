# Configuration production — copier vers .env.production
# TOUTES les valeurs change_me doivent être remplacées : le backend refuse de démarrer sinon.
# Ne jamais versionner les fichiers contenant les vraies valeurs.

ENV=production

BACKEND_PORT=4000
FRONTEND_PORT=8080
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://integrisea.example.com
TRUST_PROXY=1

DB_HOST=db
DB_PORT=3306
DB_USER=integrisea
DB_PASS=change_me
DB_NAME=integrisea
DB_ROOT_PASS=change_me_root

PMA_PORT=8088

JWT_SECRET=change_me_long_random_string
# Sessions : jeton d'accès de courte durée + jeton de rafraîchissement (rotation, révocable à la déconnexion)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
# Cookies de session : attribut Secure automatique (vide ou auto) selon la connexion reelle : actif en HTTPS (y compris derriere un proxy TLS,
# avec TRUST_PROXY=1), absent en HTTP simple (un cookie Secure y est refuse par le navigateur et la connexion echouerait). true / false pour forcer.
COOKIE_SECURE=auto
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=integrisea
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SHOW_VALIDATION_WARNING=true

# Stockage des fichiers : local (volume uploads_data, par défaut) ou s3 (service Docker optionnel)
STORAGE_DRIVER=local
