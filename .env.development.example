# Configuration development — copier vers .env.development
# Ne jamais versionner les fichiers contenant les vraies valeurs.

ENV=development

# Ports et URLs
BACKEND_PORT=4000
FRONTEND_PORT=5173
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Origines supplémentaires autorisées par le CORS du backend (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Proxy de confiance (X-Forwarded-For) : "loopback", "1", "false"…
TRUST_PROXY=loopback

# Base de données (MySQL du docker-compose, exposé sur 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=integrisea
DB_PASS=change_me
DB_NAME=integrisea
DB_ROOT_PASS=change_me_root

# phpMyAdmin (docker-compose)
PMA_PORT=8088

# Authentification
JWT_SECRET=change_me_long_random_string
# Sessions : jeton d'accès de courte durée + jeton de rafraîchissement (rotation, révocable à la déconnexion)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=8
# Duree de session maximale absolue (heures) : le renouvellement glissant ne la depasse jamais, nouvelle connexion obligatoire ensuite
SESSION_MAX_HOURS=12
# Verrouillage de compte : échecs consécutifs avant blocage, durée du blocage
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Limitation de débit des connexions par adresse IP (par fenêtre de 15 min) : 200 en développement/test, 10 par défaut en production
LOGIN_RATE_LIMIT=200

# Compte administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL=admin@integrisea.local
SEED_ADMIN_PASSWORD=change_me_admin

# Stockage S3 compatible (MinIO du docker-compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=integrisea
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Avertissement « calculs non validés » (mettre à false uniquement après validation par des ingénieurs qualifiés)
SHOW_VALIDATION_WARNING=true

# Stockage des fichiers : local (dossier backend/uploads) ou s3 (service Docker s3, RustFS)
STORAGE_DRIVER=local
